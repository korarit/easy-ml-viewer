# Easy ML Viewer Backend — environment template (copy to .env)
APP_NAME=Easy ML Viewer Backend
APP_VERSION=1.0.0
HOST=127.0.0.1
PORT=30211
# Comma-separated origins, e.g. http://localhost:30222,http://127.0.0.1:30222
FRONTEND_ORIGINS=http://localhost:30222,http://127.0.0.1:30222
MAX_PROCESS_RAM_MB=4096
MIN_SYSTEM_FREE_RAM_MB=512
MAX_UPLOAD_SIZE_MB=1024
OMP_NUM_THREADS=4
